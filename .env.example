# ==============================================================================
# Refrain - Unified Platform Environment Variables
# ==============================================================================

# Supabase Database & Auth (Recommended)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend Security
JWT_SECRET_KEY=refrain-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (MongoDB if using local FastAPI worker, or Supabase PostgreSQL)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=refrain

# CORS & Environment
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
ENVIRONMENT=development
DEBUG=true
